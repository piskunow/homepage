---
const path = Astro.url.pathname
const links = [
  { href: "/work/", label: "Work" },
  { href: "/about/", label: "About" },
  { href: "/writing/", label: "Writing" },
  { href: "/contact/", label: "Contact" },
]
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href)
---

<header class="nav">
  <div class="shell nav__inner">
    <a href="/" class="nav__mark" aria-label="Pablo Piskunow, home">
      <svg viewBox="0 0 34 18" class="nav__glyph" aria-hidden="true">
        <!-- Two levels approaching and repelling: an avoided crossing, the
             same idea the hero figure draws at full size. -->
        <path d="M1 2 C 11 2, 12 7.4, 17 7.4 C 22 7.4, 23 2, 33 2"></path>
        <path d="M1 16 C 11 16, 12 10.6, 17 10.6 C 22 10.6, 23 16, 33 16"
        ></path>
      </svg>
      <span>Pablo Piskunow</span>
    </a>

    <nav aria-label="Primary">
      <ul class="nav__list">
        {
          links.map(link => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav {
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--ground) 88%, transparent);
    backdrop-filter: blur(8px);
    position: sticky;
    top: 0;
    z-index: 20;
  }

  .nav__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding-block: 0.9rem;
  }

  .nav__mark {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-size: 1.06rem;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-decoration: none;
  }

  .nav__glyph {
    width: 34px;
    height: 18px;
    flex: none;
    fill: none;
    stroke: var(--band);
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  .nav__mark:hover .nav__glyph {
    stroke: var(--gap);
  }

  .nav__list {
    display: flex;
    flex-wrap: wrap;
    gap: 1.35rem;
    list-style: none;
    padding: 0;
    font-size: var(--step--1);
    letter-spacing: 0.01em;
  }

  .nav__list a {
    color: var(--ink-mute);
    text-decoration: none;
    padding-block: 0.2rem;
    border-bottom: 1.5px solid transparent;
  }

  .nav__list a:hover {
    color: var(--ink);
  }

  .nav__list a[aria-current="page"] {
    color: var(--ink);
    border-bottom-color: var(--gap);
  }
</style>
