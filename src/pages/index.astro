---
import { Image } from "astro:assets"
import { getCollection } from "astro:content"
import Base from "../layouts/Base.astro"
import FloquetBands from "../components/FloquetBands.astro"
import ProductCard from "../components/ProductCard.astro"
import portrait from "../assets/portrait.jpg"
import { site, products, work } from "../data/site"

const posts = (await getCollection("posts"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3)

const dateFmt = new Intl.DateTimeFormat("en-GB", {
  year: "numeric",
  month: "short",
})

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  url: site.url,
  email: `mailto:${site.email}`,
  jobTitle: site.jobTitle,
  image: new URL(portrait.src, site.url).href,
  sameAs: [
    site.links.github,
    site.links.linkedin,
    site.links.scholar,
    site.links.orcid,
  ],
  // `owns`, not `worksFor`: these are his products, not his employers.
  owns: products.map(p => ({
    "@type": "SoftwareApplication",
    name: p.name,
    url: p.url,
    description: p.summary,
    applicationCategory: "BusinessApplication",
  })),
}
---

<Base
  title={site.name}
  description="Pablo Piskunow builds and ships software products: Vigilia, TowardsGM and NightFlow. Physicist by training, engineer by trade."
  structuredData={structuredData}
>
  <section class="hero band band--flush">
    <div class="shell">
      <div class="hero__top">
        <div class="hero__text">
          <h1 class="hero__name">Pablo Piskunow</h1>
          <p class="hero__tagline">
            I build and ship software products. Physicist by training, engineer
            by trade, working from Barcelona.
          </p>
          <p class="hero__mail mono">
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </p>
        </div>

        <Image
          src={portrait}
          alt="Pablo Piskunow"
          class="hero__portrait"
          width={280}
          height={280}
          quality={82}
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <FloquetBands />
    </div>
  </section>

  <section class="band" aria-labelledby="products-heading">
    <div class="shell">
      <h2 class="band-label" id="products-heading">products</h2>
      <div class="grid-3">
        {products.map(product => <ProductCard product={product} />)}
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="work-heading">
    <div class="shell">
      <h2 class="band-label" id="work-heading">selected work</h2>
      <ul class="worklist">
        {
          work.map(item => (
            <li class="worklist__item">
              <div class="worklist__head">
                <h3 class="worklist__name">{item.name}</h3>
                <span class="worklist__years mono">{item.years}</span>
              </div>
              <p class="worklist__role mono">{item.role}</p>
              <p class="worklist__summary">{item.summary}</p>
            </li>
          ))
        }
      </ul>
      <p class="band__more">
        <a href="/work/">All work and projects</a>
      </p>
    </div>
  </section>

  <section class="band" aria-labelledby="writing-heading">
    <div class="shell">
      <h2 class="band-label" id="writing-heading">writing</h2>
      <ul class="postlist">
        {
          posts.map(post => (
            <li>
              <a href={`/${post.id}/`}>{post.data.title}</a>
              <time class="mono" datetime={post.data.date.toISOString()}>
                {dateFmt.format(post.data.date)}
              </time>
            </li>
          ))
        }
      </ul>
      <p class="band__more">
        <a href="/writing/">All writing</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-top: clamp(3rem, 7vw, 5.5rem);
  }

  .hero__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2rem 3rem;
    margin-bottom: clamp(3rem, 6vw, 4.5rem);
  }

  .hero__text {
    flex: 1 1 22rem;
  }

  .hero__name {
    font-size: var(--step-5);
    letter-spacing: -0.028em;
  }

  .hero__tagline {
    margin-top: 1.1rem;
    max-width: 34ch;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink-mute);
  }

  .hero__mail {
    margin-top: 1.5rem;
  }

  .hero__portrait {
    flex: none;
    width: clamp(112px, 20vw, 168px);
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border: 1px solid var(--line-strong);
    filter: grayscale(1) contrast(1.04);
  }

  .grid-3 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 1.25rem;
  }

  .worklist {
    list-style: none;
    padding: 0;
    display: grid;
    /* Two columns, so four items land as a balanced 2x2 rather than
       leaving one stranded on a second row. */
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
    gap: 2.25rem 3.5rem;
  }

  .worklist__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.45rem;
  }

  .worklist__name {
    font-size: var(--step-1);
  }

  .worklist__years,
  .worklist__role {
    color: var(--ink-mute);
  }

  .worklist__role {
    margin-top: 0.5rem;
    color: var(--gap);
  }

  .worklist__summary {
    margin-top: 0.45rem;
    color: var(--ink-mute);
    font-size: var(--step--1);
    line-height: 1.7;
  }

  .postlist {
    list-style: none;
    padding: 0;
    max-width: var(--measure);
  }

  .postlist li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--line);
  }

  .postlist a {
    color: var(--ink);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: var(--step-1);
  }

  .postlist a:hover {
    color: var(--band);
  }

  .postlist time {
    color: var(--ink-mute);
    white-space: nowrap;
  }

  .band__more {
    margin-top: 2rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }
</style>
