---
import { getCollection, render } from "astro:content"
import Base from "../layouts/Base.astro"
import { site } from "../data/site"

export async function getStaticPaths() {
  const posts = await getCollection("posts")
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }))
}

const { post } = Astro.props
const { Content, headings } = await render(post)

const dateFmt = new Intl.DateTimeFormat("en-GB", {
  year: "numeric",
  month: "long",
  day: "numeric",
})

const toc = headings.filter(h => h.depth === 2 || h.depth === 3)

const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  dateModified: (post.data.update ?? post.data.date).toISOString(),
  author: { "@type": "Person", name: site.name, url: site.url },
  mainEntityOfPage: new URL(`/${post.id}/`, site.url).href,
}
---

<Base
  title={post.data.title}
  description={post.data.description ??
    `${post.data.title} — writing by ${site.name}.`}
  structuredData={structuredData}
>
  <article class="band band--flush">
    <div class="shell">
      <header class="post-head">
        <p class="post-head__back mono"><a href="/writing/">← Writing</a></p>
        <h1>{post.data.title}</h1>
        <p class="post-head__meta mono">
          <time datetime={post.data.date.toISOString()}>
            {dateFmt.format(post.data.date)}
          </time>
          {
            post.data.tags.length > 0 && (
              <span class="post-head__tags">{post.data.tags.join(" · ")}</span>
            )
          }
        </p>
      </header>

      <div class="post-body">
        {
          toc.length > 2 && (
            <nav class="toc" aria-label="On this page">
              <p class="toc__key mono">On this page</p>
              <ul>
                {toc.map(h => (
                  <li data-depth={h.depth}>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }

        <div class="markdown">
          <Content />
        </div>
      </div>
    </div>
  </article>
</Base>

<style is:global>
  .post-head {
    max-width: var(--measure);
  }

  .post-head__back {
    margin-bottom: 1.5rem;
  }

  .post-head__back a {
    color: var(--ink-mute);
    text-decoration: none;
  }

  .post-head__back a:hover {
    color: var(--band);
  }

  .post-head h1 {
    font-size: var(--step-4);
  }

  .post-head__meta {
    margin-top: 1.1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    color: var(--ink-mute);
  }

  .post-head__tags {
    color: var(--gap);
  }

  .post-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
    margin-top: 3.5rem;
  }

  @media (min-width: 64rem) {
    .post-body {
      grid-template-columns: minmax(0, 1fr) 14rem;
      align-items: start;
    }
    .toc {
      order: 2;
      position: sticky;
      top: 5.5rem;
    }
  }

  .toc__key {
    color: var(--ink-mute);
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--line);
  }

  .toc ul {
    list-style: none;
    padding: 0;
    margin-top: 0.8rem;
    display: grid;
    gap: 0.5rem;
  }

  .toc li[data-depth="3"] {
    padding-left: 0.9rem;
  }

  .toc a {
    font-size: 0.82rem;
    color: var(--ink-mute);
    text-decoration: none;
    line-height: 1.45;
  }

  .toc a:hover {
    color: var(--band);
  }

  .markdown {
    max-width: var(--measure);
  }

  .markdown > * + * {
    margin-top: 1.25rem;
  }

  .markdown h2 {
    font-size: var(--step-3);
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .markdown h3 {
    font-size: var(--step-2);
    margin-top: 2.25rem;
  }

  .markdown h4 {
    font-size: var(--step-1);
    margin-top: 1.75rem;
  }

  .markdown ul,
  .markdown ol {
    padding-left: 1.35rem;
    display: grid;
    gap: 0.5rem;
  }

  .markdown li > ul,
  .markdown li > ol {
    margin-top: 0.5rem;
  }

  .markdown img {
    border: 1px solid var(--line);
    background: var(--surface);
    margin-inline: auto;
  }

  .markdown blockquote {
    border-left: 2px solid var(--gap);
    padding-left: 1.1rem;
    color: var(--ink-mute);
    font-style: italic;
  }

  .markdown code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: color-mix(in srgb, var(--ink) 6%, transparent);
    padding: 0.12em 0.35em;
    border-radius: 2px;
  }

  .markdown pre {
    padding: 1.1rem 1.2rem;
    overflow-x: auto;
    border: 1px solid var(--line);
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .markdown pre code {
    background: none;
    padding: 0;
    font-size: inherit;
  }

  .markdown hr {
    border: 0;
    border-top: 1px solid var(--line);
    margin-block: 2.5rem;
  }

  .markdown table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--step--1);
    display: block;
    overflow-x: auto;
  }

  .markdown th,
  .markdown td {
    border: 1px solid var(--line);
    padding: 0.5rem 0.7rem;
    text-align: left;
  }

  .markdown div[style*="flex"] {
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>
