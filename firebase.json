{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": false,
    "trailingSlash": true,
    "redirects": [
      {
        "source": "/this-website",
        "destination": "/writing/",
        "type": 301
      },
      {
        "source": "/this-website/**",
        "destination": "/writing/",
        "type": 301
      },
      {
        "source": "/series{,/**}",
        "destination": "/writing/",
        "type": 301
      },
      {
        "source": "/tags{,/**}",
        "destination": "/writing/",
        "type": 301
      },
      {
        "source": "/search{,/**}",
        "destination": "/writing/",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**/*.@(woff2|woff|ttf)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|png|svg|webp|avif|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=604800"
          }
        ]
      }
    ]
  }
}
